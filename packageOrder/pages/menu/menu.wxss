/* pages/menu/menu.wxss */
page {
  height: 100%;
  background-color: #f8f8f8;
  display: flex;
  flex-direction: column;
}

.menu-page {
  /* padding-top 通过内联样式动态设置 */
}

/* 自定义顶部导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: linear-gradient(135deg, #07c160 0%, #059c53 100%);
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.2);
}

.nav-bar-content {
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  gap: 40rpx;
}

.nav-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 100%;
  padding: 0 20rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 30rpx;
  position: relative;
  transition: all 0.3s;
}

.nav-tab.active {
  color: #fff;
  font-weight: bold;
}

.nav-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #fff;
  border-radius: 3rpx;
}

/* 点菜容器：外层纵向flex（上中下） */
.menu-container {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 中间内容区：内层横向flex（左右） */
.content-row {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 左侧分类样式 */
.sidebar {
  width: 180rpx;
  background-color: #f4f4f4;
  height: 100%;
  flex-shrink: 0;
}

.sidebar-item {
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #666;
  position: relative;
}

.sidebar-item.active {
  background-color: #ffffff;
  color: #333333;
  font-weight: bold;
}

.sidebar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 35rpx;
  height: 40rpx;
  width: 8rpx;
  background-color: #ffcc00; /* 点餐系统经典黄色主色调 */
  border-radius: 0 4rpx 4rpx 0;
}

/* 右侧商品列表样式 */
.goods-container {
  flex: 1;
  background-color: #ffffff;
  height: 100%;
  padding: 0 20rpx 0 20rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.category-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  padding: 24rpx 0 10rpx 0;
  background-color: #ffffff;
}

/* van-card 自定义样式 */
.card-num {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
}
.card-info .van-card__bottom{
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-desc {
  font-size: 20rpx;
  color: #999;
  line-height: 30rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.goods-sales {
  font-size: 20rpx;
  color: #999;
  display: block;
  margin-top: 5rpx;
}

/* 底部结算栏样式 */
.bottom-bar {
  height: 100rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  flex-shrink: 0;
}

.cart-icon-wrapper {
  position: relative;
  display: inline-block;
  padding: 10rpx 30rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: 10rpx;
  background-color: #ee0a24;
  color: white;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  z-index: 100;
}

/* 购物车弹窗样式 */
.cart-modal-content {
  padding: 30rpx;
  max-height: 70vh;
}

.cart-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f2f2;
}

.cart-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.cart-modal-body {
  max-height: calc(70vh - 120rpx);
  padding: 20rpx 0;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.cart-item:last-child {
  border-bottom: none;
}

.cart-item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  background-color: #f5f5f5;
}

.cart-item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cart-item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.cart-item-price {
  font-size: 26rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.cart-modal-empty {
  padding: 60rpx 0;
}

/* 订单列表样式 */
.order-list-container {
  /* height 通过内联样式动态设置 */
  background: #f7f8fa;
  display: flex;
  flex-direction: column;
}

.order-list-header {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.order-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}

.order-scroll {
  flex: 1;
  height: calc(100vh - 120rpx);
}

.order-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.order-card:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.order-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no-text {
  font-size: 26rpx;
  color: #999;
  font-family: monospace;
}

.order-card-body {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-detail-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 12rpx;
}

.order-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-price {
  font-size: 32rpx;
  color: #ff4400;
  font-weight: bold;
}

.order-count {
  font-size: 24rpx;
  color: #666;
}

.order-card-bottom {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: 16rpx;
  gap: 8rpx;
}

.order-view-detail {
  font-size: 24rpx;
  color: #999;
}

.order-empty {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60vh;
}