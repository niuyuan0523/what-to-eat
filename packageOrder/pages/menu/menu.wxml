<view class="menu-page" style="padding-top: {{navTotalHeight}}px;">

  <!-- 自定义顶部导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-content" style="height: {{navBarHeight}}px;">
      <view 
        class="nav-tab {{activeNav === 0 ? 'active' : ''}}" 
        bindtap="switchNav" 
        data-index="0"
      >
        <van-icon name="shop-o" size="16px" />
        <text>点菜</text>
      </view>
      <view 
        class="nav-tab {{activeNav === 1 ? 'active' : ''}}" 
        bindtap="switchNav" 
        data-index="1"
      >
        <van-icon name="orders-o" size="16px" />
        <text>订单</text>
      </view>
    </view>
  </view>

  <!-- 点菜页面 -->
  <view class="menu-container" style="height: calc(100vh - {{navTotalHeight}}px - {{bottomHeight}}px);" wx:if="{{activeNav === 0}}">

    <!-- 浏览他人菜单提示（通过分享链接进入） -->
    <view class="owner-banner" wx:if="{{!isOwner}}">
      <text>👨‍🍳 你正在家人的菜单里点菜，提交后记得把订单分享给TA</text>
    </view>

    <!-- 中间内容区：左侧分类 + 右侧商品 -->
    <view class="content-row">
      <!-- 左侧分类导航 -->
      <scroll-view class="sidebar" scroll-y scroll-with-animation>
        <view 
          class="sidebar-item {{currentTab === index ? 'active' : ''}}" 
          wx:for="{{categories}}" 
          wx:key="id" 
          bindtap="switchCategory" 
          data-index="{{index}}"
          data-id="{{item.id}}"
        >
          <text class="sidebar-text">{{item.name}}</text>
        </view>
      </scroll-view>

      <!-- 右侧商品列表 -->
      <scroll-view 
        class="goods-container" 
        scroll-y 
        scroll-into-view="{{toView}}" 
        scroll-with-animation
        bindscroll="onGoodsScroll"
      >
        <view class="category-group" wx:for="{{categories}}" wx:key="id" id="{{item.id}}">
          <view class="category-title">{{item.name}}</view>
          
          <!-- 使用 van-card 展示菜品（点击卡片查看点评/打赏） -->
          <view 
            wx:for="{{item.goodsList}}" 
            wx:for-item="goods" 
            wx:key="id"
            bindtap="openDishModal"
            data-id="{{goods.id}}"
          >
            <van-card 
              title="{{goods.name}}"
              desc="{{goods.desc}}"
              thumb="{{goods.image}}"
              tag="{{goods.totalReward > 0 ? '❤ ' + goods.totalReward : ''}}"
              class="card-info"
            >
              <!-- 累计点单/点评信息 -->
              <view slot="bottom" class="card-meta">
                <text class="card-meta-item" wx:if="{{goods.sales > 0}}">月点 {{goods.sales}}</text>
                <text class="card-meta-item" wx:if="{{goods.commentCount > 0}}">{{goods.commentCount}} 条点评</text>
              </view>
              <!-- 自定义数量控制器（catchtap 防止触发卡片点击） -->
              <view slot="num" class="card-num" catchtap="stopPropagation">
                <van-stepper 
                  button-size="20px"
                  theme="round"
                  disable-input
                  value="{{goods.cartCount || 0}}" 
                  min="0"
                  bind:change="onGoodsStepperChange" 
                  data-id="{{goods.id}}"
                />
              </view>
            </van-card>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 底部提交栏（家庭点餐无价格） -->
    <view class="submit-bar">
      <view class="cart-icon-wrapper" bindtap="showCartModal">
        <van-icon name="shopping-cart-o" size="50rpx" color="{{cartCount > 0 ? '#07c160' : '#999'}}" />
        <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
      </view>
      <view class="submit-bar-text">
        <text wx:if="{{cartCount > 0}}">已选 {{cartCount}} 道菜</text>
        <text wx:else class="submit-bar-placeholder">今天想吃点什么？</text>
      </view>
      <button class="share-btn" open-type="share" plain>
        <van-icon name="share-o" size="16px" />
        <text>叫家人点</text>
      </button>
      <view class="submit-btn {{cartCount === 0 ? 'disabled' : ''}}" bindtap="onCheckout">
        {{cartCount > 0 ? '提交点餐' : '请点餐'}}
      </view>
    </view>

    <!-- 购物车弹窗 -->
    <van-popup show="{{showCart}}" position="bottom" round bind:close="hideCartModal">
      <view class="cart-modal-content">
        <view class="cart-modal-header">
          <text class="cart-modal-title">已选商品</text>
          <van-button size="small" type="default" bindtap="clearCart" wx:if="{{cartCount > 0}}">清空</van-button>
        </view>
        <scroll-view class="cart-modal-body" scroll-y wx:if="{{cartCount > 0}}">
          <view class="cart-item" wx:for="{{cartItems}}" wx:key="id">
            <image class="cart-item-img" src="{{item.image}}" mode="aspectFill"></image>
            <view class="cart-item-info">
              <text class="cart-item-name">{{item.name}}</text>
            </view>
            <van-stepper 
              button-size="22px"
              theme="round"
              disable-input
              value="{{item.cartCount}}" 
              min="0"
              bind:change="onStepperChange" 
              data-id="{{item.id}}" 
            />
          </view>
        </scroll-view>
        <view class="cart-modal-empty" wx:else>
          <van-empty description="购物车是空的" />
        </view>
      </view>
    </van-popup>

    <!-- 菜品点评 / 打赏弹窗 -->
    <van-popup show="{{showDishModal}}" position="bottom" round closeable bind:close="hideDishModal">
      <view class="dish-modal-content" wx:if="{{currentDish}}">
        <!-- 菜品信息 -->
        <view class="dish-header">
          <image class="dish-image" src="{{currentDish.image}}" mode="aspectFill" wx:if="{{currentDish.image}}"></image>
          <view class="dish-image dish-image-placeholder" wx:else>🍽️</view>
          <view class="dish-info">
            <text class="dish-name">{{currentDish.name}}</text>
            <text class="dish-desc">{{currentDish.desc}}</text>
            <view class="dish-stats">
              <text class="dish-reward">❤ {{currentDish.totalReward || 0}}</text>
              <text class="dish-comment-count">{{currentDish.commentCount || 0}} 条点评</text>
            </view>
          </view>
        </view>

        <!-- 评论列表 -->
        <scroll-view class="comment-list" scroll-y>
          <view class="comment-loading" wx:if="{{commentLoading}}">
            <van-loading size="24px">加载中...</van-loading>
          </view>
          <block wx:elif="{{comments.length > 0}}">
            <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
              <view class="comment-item-top">
                <text class="comment-author">{{item.authorName}}</text>
                <text class="comment-reward" wx:if="{{item.reward > 0}}">❤ x{{item.reward}}</text>
              </view>
              <text class="comment-content" wx:if="{{item.content}}">{{item.content}}</text>
              <text class="comment-time">{{item.timeText}}</text>
            </view>
          </block>
          <view class="comment-empty" wx:else>
            <text>还没有点评，快来抢沙发~</text>
          </view>
        </scroll-view>

        <!-- 点评输入区 -->
        <view class="comment-form">
          <van-field
            value="{{authorName}}"
            placeholder="你的称呼（如：媳妇、儿子）"
            border="{{true}}"
            bind:change="onAuthorNameInput"
          />
          <van-field
            value="{{commentText}}"
            type="textarea"
            placeholder="味道怎么样？说两句吧~"
            autosize="{{ {maxHeight: 120, minHeight: 60} }}"
            maxlength="200"
            show-word-limit
            border="{{true}}"
            bind:change="onCommentInput"
          />
          <view class="reward-row">
            <text class="reward-label">送爱心打赏</text>
            <van-stepper
              value="{{rewardCount}}"
              min="0"
              max="99"
              theme="round"
              button-size="22px"
              disable-input
              bind:change="onRewardChange"
            />
          </view>
          <van-button type="primary" block round bindtap="submitComment">
            {{rewardCount > 0 ? '点评并送出 ' + rewardCount + ' 颗爱心 ❤' : '发表点评'}}
          </van-button>
        </view>
      </view>
    </van-popup>

  </view>

  <!-- 订单列表页面 -->
  <view class="order-list-container" style="height: calc(100vh - {{navTotalHeight}}px);" wx:if="{{activeNav === 1}}">
    <view class="order-list-header">
      <van-button size="small" type="default" icon="replay" bindtap="loadOrderList">刷新</van-button>
    </view>
    
    <!-- 订单列表加载中 -->
    <view class="order-loading" wx:if="{{orderLoading}}">
      <van-loading type="spinner" color="#07c160" size="40px">加载中...</van-loading>
    </view>
    
    <!-- 订单列表 -->
    <scroll-view class="order-scroll" scroll-y wx:elif="{{orderList.length > 0}}">
      <view 
        class="order-card" 
        wx:for="{{orderList}}" 
        wx:key="_id"
        bindtap="goToOrderDetail"
        data-id="{{item._id}}"
        data-order-no="{{item.orderNo}}"
      >
        <view class="order-card-top">
          <text class="order-no-text">#{{item.orderNo}}</text>
          <van-tag type="{{item.status === 'pending' ? 'warning' : item.status === 'completed' ? 'success' : item.status === 'cancelled' ? 'danger' : 'primary'}}" plain>
            {{item.statusText}}
          </van-tag>
        </view>
        <view class="order-card-body">
          <view class="order-items-preview">
            <text class="order-detail-text">{{item.orderDetail}}</text>
          </view>
          <view class="order-info-row">
            <text class="order-time">{{item.orderTime}}</text>
            <text class="order-count">共{{item.cartCount}}道菜</text>
          </view>
        </view>
        <view class="order-card-bottom">
          <text class="order-view-detail">查看详情</text>
          <van-icon name="arrow" size="14px" color="#999" />
        </view>
      </view>
      <view style="height: 40rpx;"></view>
    </scroll-view>
    
    <!-- 空订单 -->
    <view class="order-empty" wx:else>
      <van-empty description="暂无订单" image="search">
        <van-button type="primary" size="small" plain round bindtap="switchNav" data-index="0">
          去点餐
        </van-button>
      </van-empty>
    </view>
  </view>

</view>