<view class="order-detail-page">
  <!-- 加载中状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <van-loading type="spinner" color="#07c160" size="40px">加载中...</van-loading>
  </view>

  <!-- 订单详情 -->
  <view class="detail-container" wx:if="{{!loading && orderDetail}}">
    <!-- 订单状态 -->
    <view class="status-section">
      <view class="status-icon">
        <van-icon name="success" color="#07c160" size="60px" />
      </view>
      <text class="status-text">{{orderStatus}}</text>
      <text class="order-no">订单号: {{orderNo}}</text>
    </view>

    <!-- 订单信息 -->
    <view class="info-section">
      <van-cell-group>
        <van-cell 
          title="下单时间" 
          value="{{orderDetail.orderTime}}"
          value-class="value-text"
        />
        <van-cell 
          title="订单状态" 
          value="{{orderStatus}}"
          value-class="value-text"
        />
        <van-cell 
          title="菜品数量" 
          value="{{orderDetail.cartCount}}道"
          value-class="value-text"
        />
      </van-cell-group>
    </view>

    <!-- 菜品列表 -->
    <view class="goods-section">
      <view class="section-title">菜品详情</view>
      <view class="goods-list">
        <van-card
          wx:for="{{orderDetail.items}}"
          wx:key="id"
          title="{{item.name}}"
          desc="{{item.desc || ''}}"
          thumb="{{item.image}}"
          thumb-mode="aspectFill"
          num="{{item.cartCount}}"
        />
      </view>
    </view>

    <!-- 温馨提示 -->
    <view class="tips-section">
      <van-icon name="info-o" color="#07c160" size="20px" />
      <text class="tips-text">{{showShareTip ? '把订单分享给掌勺人，提醒TA开火吧~' : '订单已提交，坐等开饭吧~'}}</text>
    </view>

    <!-- 状态操作：掌勺人流转状态 / 下单人取消待处理订单 -->
    <view class="status-actions" wx:if="{{statusActions.length > 0}}">
      <van-button
        wx:for="{{statusActions}}"
        wx:key="status"
        type="{{item.type}}"
        size="large"
        round
        plain="{{item.type === 'default'}}"
        custom-class="status-action-btn"
        data-status="{{item.status}}"
        data-label="{{item.label}}"
        bindtap="onStatusAction"
      >
        {{item.label}}
      </van-button>
    </view>
    <view class="status-actions" wx:elif="{{isBuyer && !isOwner && orderDetail.status === 'pending'}}">
      <van-button
        type="default"
        size="large"
        round
        plain
        custom-class="status-action-btn"
        bindtap="onBuyerCancel"
      >
        取消订单
      </van-button>
    </view>

    <!-- 分享给掌勺人 -->
    <view class="share-section">
      <button class="share-owner-btn" open-type="share">
        <van-icon name="share-o" size="18px" color="#fff" />
        <text>把菜单发给掌勺人</text>
      </button>
    </view>

    <!-- 底部按钮 -->
    <view class="bottom-buttons">
      <van-button 
        type="default" 
        size="large"
        plain
        round
        icon="home-o"
        bindtap="goHome"
      >
        返回首页
      </van-button>
      <van-button 
        type="primary" 
        size="large"
        plain
        round
        icon="replay"
        bindtap="refreshOrder"
      >
        刷新订单
      </van-button>
    </view>
  </view>

  <!-- 订单不存在 -->
  <view class="empty-container" wx:if="{{!loading && !orderDetail}}">
    <van-empty 
      description="订单不存在"
      image="error"
    >
      <van-button 
        type="primary" 
        size="small"
        plain
        round
        bindtap="goBack"
      >
        返回
      </van-button>
    </van-empty>
  </view>
</view>
