/* 方块跳跳消：全屏 Canvas 游戏页面样式（由 H5 版 CSS 移植，px → rpx） */
page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #1e293b;
}

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.game-canvas {
  display: block;
  width: 100vw;
  height: 100vh;
}

/* ---------- HUD ---------- */
.hud {
  position: fixed;
  z-index: 10;
  pointer-events: none;
}

.score-box {
  /* top 由 WXML 内联样式按状态栏高度动态设置 */
  left: 28rpx;
  background: rgba(15, 23, 42, .55);
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 28rpx;
  padding: 16rpx 32rpx;
  color: #fff;
}

.score-box .score {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.1;
}

.score-box .best {
  font-size: 24rpx;
  color: #94a3b8;
}

.combo-tag {
  /* top 由 WXML 内联样式按状态栏高度动态设置 */
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #f59e0b, #ef4444);
  color: #fff;
  font-weight: 800;
  font-size: 30rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  opacity: 0;
  transition: opacity .25s, transform .25s;
  box-shadow: 0 8rpx 28rpx rgba(239, 68, 68, .4);
}

.combo-tag.show {
  opacity: 1;
  transform: translateX(-50%) scale(1.08);
}

/* ---------- 收集槽 ---------- */
.tray {
  bottom: calc(env(safe-area-inset-bottom) + 36rpx);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 14rpx;
  background: rgba(15, 23, 42, .55);
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 32rpx;
  padding: 16rpx;
}

.slot {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .08);
  border: 2rpx dashed rgba(255, 255, 255, .18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  transition: transform .15s;
  box-sizing: border-box;
}

.slot.filled {
  border-style: solid;
  background: rgba(255, 255, 255, .92);
  transform: scale(1.02);
}

.slot.clearing {
  animation: slotPop .35s ease forwards;
}

@keyframes slotPop {
  50% { transform: scale(1.3); background: #fde68a; }
  100% { transform: scale(0); opacity: 0; }
}

/* ---------- 蓄力条 ---------- */
.power-wrap {
  bottom: calc(env(safe-area-inset-bottom) + 168rpx);
  left: 50%;
  transform: translateX(-50%);
  width: 420rpx;
  height: 24rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, .55);
  border: 1rpx solid rgba(255, 255, 255, .15);
  overflow: hidden;
  opacity: 0;
  transition: opacity .2s;
}

.power-wrap.show {
  opacity: 1;
}

.power-bar {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #22d3ee, #a78bfa, #f472b6);
  border-radius: 999rpx;
}

/* ---------- 返回主页 ---------- */
.back-home {
  position: fixed;
  bottom: calc(env(safe-area-inset-bottom) + 180rpx);
  right: 28rpx;
  z-index: 30;
  color: #cbd5e1;
  font-size: 24rpx;
  background: rgba(15, 23, 42, .55);
  border: 1rpx solid rgba(255, 255, 255, .12);
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
}

/* ---------- 遮罩层 ---------- */
.overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, .62);
  color: #fff;
  text-align: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.overlay .title {
  font-size: 84rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, #22d3ee, #a78bfa, #f472b6);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-bottom: 20rpx;
}

.overlay .sub {
  color: #cbd5e1;
  font-size: 30rpx;
  margin-bottom: 44rpx;
}

.rules {
  background: rgba(255, 255, 255, .07);
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 32rpx;
  padding: 32rpx 40rpx;
  max-width: 640rpx;
  text-align: left;
  font-size: 28rpx;
  line-height: 2;
  color: #e2e8f0;
  margin-bottom: 52rpx;
}

.rules .hl {
  color: #fbbf24;
  font-weight: 700;
}

.btn {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  padding: 28rpx 92rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #6366f1, #a855f7);
  box-shadow: 0 16rpx 48rpx rgba(139, 92, 246, .45);
  transition: transform .15s;
}

.btn:active {
  transform: scale(.94);
}

.btn-row {
  display: flex;
  gap: 28rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.btn.ghost {
  background: rgba(255, 255, 255, .12);
  box-shadow: none;
  border: 1rpx solid rgba(255, 255, 255, .28);
}

.diff-row {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.diff-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 26rpx 40rpx;
  font-size: 34rpx;
}

.diff-btn .diff-sub {
  font-size: 22rpx;
  font-weight: 500;
  opacity: .85;
}

.diff-btn.easy {
  background: linear-gradient(135deg, #10b981, #059669);
  box-shadow: 0 16rpx 48rpx rgba(16, 185, 129, .4);
}

.diff-btn.medium {
  background: linear-gradient(135deg, #f59e0b, #ef4444);
  box-shadow: 0 16rpx 48rpx rgba(245, 158, 11, .4);
}

.diff-btn.hard {
  background: linear-gradient(135deg, #06b6d4, #3b82f6);
  box-shadow: 0 16rpx 48rpx rgba(6, 182, 212, .4);
}

.over-reason {
  font-size: 34rpx;
  color: #fca5a5;
  margin-bottom: 8rpx;
}

.over-score {
  font-size: 108rpx;
  font-weight: 900;
  margin: 12rpx 0 4rpx;
}

.over-best {
  color: #94a3b8;
  font-size: 28rpx;
  margin-bottom: 48rpx;
}
