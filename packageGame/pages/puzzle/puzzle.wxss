/* 乾坤挪移：全屏 Canvas 游戏页面样式 */
page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #1e1b4b;
}

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.game-canvas {
  display: block;
  width: 100vw;
  height: 100vh;
}

/* ---------- HUD ---------- */
.hud {
  position: fixed;
  z-index: 10;
  pointer-events: none;
}

.top-bar {
  left: 28rpx;
  right: 28rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 16rpx;
}

.stat-box {
  min-width: 130rpx;
  background: rgba(15, 23, 42, .55);
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 24rpx;
  padding: 14rpx 24rpx;
  color: #fff;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: #c4b5fd;
}

.level-tag {
  flex: 1;
  background: rgba(15, 23, 42, .55);
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 24rpx;
  padding: 14rpx 24rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.level-best {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #fbbf24;
}

/* ---------- 对局操作条 ---------- */
.action-bar {
  position: fixed;
  z-index: 12;
  left: 50%;
  transform: translateX(-50%);
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 22rpx;
}

.act-btn {
  background: rgba(15, 23, 42, .55);
  border: 1rpx solid rgba(255, 255, 255, .2);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0 40rpx;
  height: 92rpx;
  border-radius: 999rpx;
  /* 文字水平 + 垂直居中，且不换行 */
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1;
  white-space: nowrap;
  flex-shrink: 0;
}

.act-btn:active {
  transform: scale(.95);
}

.act-btn.peek {
  background: linear-gradient(135deg, #7c3aed, #a855f7);
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, .4);
}

/* ---------- 角落按钮 ---------- */
.back-home {
  position: fixed;
  z-index: 40;
  left: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(15, 23, 42, .5);
  border: 1rpx solid rgba(255, 255, 255, .18);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}

/* ---------- 遮罩层 ---------- */
.overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  background: rgba(15, 10, 40, .72);
  backdrop-filter: blur(6rpx);
}

/* 选关页：关卡多时可上下滚动，避免小屏被裁切 */
.overlay.scroll {
  justify-content: flex-start;
  padding-top: calc(120rpx + env(safe-area-inset-top));
  padding-bottom: 60rpx;
  overflow-y: auto;
}

.title {
  font-size: 72rpx;
  font-weight: 900;
  color: #fff;
  text-shadow: 0 8rpx 30rpx rgba(168, 85, 247, .55);
}

.sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #ddd6fe;
}

.rules {
  margin-top: 36rpx;
  width: 100%;
  max-width: 620rpx;
  background: rgba(255, 255, 255, .08);
  border: 1rpx solid rgba(255, 255, 255, .12);
  border-radius: 24rpx;
  padding: 26rpx 32rpx;
  color: #e2e8f0;
  font-size: 26rpx;
  line-height: 2;
}

.hl {
  color: #fbbf24;
  font-weight: 700;
}

/* 关卡宫格 */
.level-grid {
  margin-top: 36rpx;
  width: 100%;
  max-width: 640rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: center;
}

.level-card {
  width: 190rpx;
  padding: 22rpx 0 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .1);
  border: 2rpx solid rgba(255, 255, 255, .14);
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.level-card:active {
  transform: scale(.95);
}

.level-card.locked {
  opacity: .45;
}

/* 照片关入口：虚线边框区分原创图案关 */
.level-card.photo {
  border: 2rpx dashed rgba(255, 255, 255, .45);
  background: rgba(255, 255, 255, .06);
}

.level-icon {
  font-size: 56rpx;
}

.level-name {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.level-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #c4b5fd;
}

/* ---------- 过关结算 ---------- */
.win-icon {
  font-size: 110rpx;
}

.win-title {
  margin-top: 16rpx;
  font-size: 64rpx;
  font-weight: 900;
  color: #fff;
}

.win-stats {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  color: #ddd6fe;
}

.win-new {
  color: #fbbf24;
  font-weight: 700;
  font-size: 28rpx;
}

/* 按钮 */
.btn-col {
  margin-top: 44rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  width: 100%;
  max-width: 560rpx;
}

.btn {
  text-align: center;
  padding: 24rpx 44rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: rgba(255, 255, 255, .14);
  border: 1rpx solid rgba(255, 255, 255, .2);
}

.btn.primary {
  background: linear-gradient(135deg, #8b5cf6, #d946ef);
  border: none;
  box-shadow: 0 10rpx 30rpx rgba(168, 85, 247, .45);
}

.btn.ghost {
  background: rgba(255, 255, 255, .1);
}

.btn:active {
  transform: scale(.96);
}
