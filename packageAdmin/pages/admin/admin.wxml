<view class="container">
  <!-- 顶部操作栏 -->
  <view class="header">
    <text class="title">我的菜单</text>
    <view class="actions">
      <button class="btn btn-small" bindtap="previewMenu">预览菜单</button>
      <button class="btn btn-small" bindtap="exportData">导出数据</button>
      <button class="btn btn-small btn-primary" bindtap="importData">导入数据</button>
    </view>
  </view>

  <!-- 分类标签栏 -->
  <view class="category-tabs">
    <scroll-view scroll-x class="tabs-scroll">
      <view 
        class="tab-item {{currentTab === index ? 'active' : ''}}" 
        wx:for="{{categories}}" 
        wx:key="id"
        bindtap="switchCategory"
        data-index="{{index}}"
      >
        {{item.name}}
      </view>
      <view class="tab-item add-tab" bindtap="addCategory">+ 添加</view>
    </scroll-view>
  </view>

  <!-- 当前分类内容 -->
  <view class="content" wx:if="{{categories[currentTab]}}">
    <!-- 分类操作栏 -->
    <view class="category-actions">
      <text class="category-name">{{categories[currentTab].name}}</text>
      <view class="action-buttons">
        <button class="btn btn-small" bindtap="editCategory">编辑分类</button>
        <button class="btn btn-small btn-danger" bindtap="deleteCategory">删除分类</button>
        <button class="btn btn-small btn-primary" bindtap="addGoods">+ 添加菜品</button>
      </view>
    </view>

    <!-- 菜品列表 -->
    <view class="goods-list">
      <view class="goods-item" wx:for="{{categories[currentTab].goodsList}}" wx:key="id" wx:for-index="goodsIndex">
        <image class="goods-image" src="{{item.image}}" mode="aspectFill" />
        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <text class="goods-desc">{{item.desc}}</text>
          <text class="goods-id">ID: {{item.id}}</text>
        </view>
        <view class="goods-actions">
          <button class="btn-icon" bindtap="editGoods" data-index="{{goodsIndex}}">编辑</button>
          <button class="btn-icon btn-danger" bindtap="deleteGoods" data-index="{{goodsIndex}}">删除</button>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{categories[currentTab].goodsList.length === 0}}">
        <text class="empty-text">暂无菜品，点击"添加菜品"记录你的拿手菜</text>
      </view>
    </view>
  </view>

  <!-- 编辑弹窗 - 使用 Vant Popup -->
  <van-popup 
    show="{{showEditModal}}" 
    position="bottom"
    round
    custom-style="height: 75%; max-height: 1200rpx;"
    bind:close="closeModal"
  >
    <view class="modal-container">
      <!-- 弹窗标题 -->
      <view class="modal-header">
        <text class="modal-title">
          <van-icon name="{{editMode === 'add' ? 'plus' : 'edit'}}" size="18px" />
          {{editMode === 'add' ? '添加' : '编辑'}} {{editType === 'category' ? '分类' : '菜品'}}
        </text>
        <van-icon name="cross" size="20px" color="#999" bindtap="closeModal" />
      </view>

      <!-- 表单内容 -->
      <scroll-view scroll-y class="modal-body">
        <!-- 分类表单 -->
        <block wx:if="{{editType === 'category'}}">
          <van-field
            value="{{formData.name}}"
            bind:change="onFieldChange"
            data-field="name"
            label="分类名称"
            placeholder="请输入分类名称"
            required
            clearable
            border="{{true}}"
          />
          <van-field
            value="{{formData.id}}"
            bind:change="onFieldChange"
            data-field="id"
            label="分类 ID"
            placeholder="自动生成"
            disabled="{{editMode === 'edit'}}"
            border="{{true}}"
          />
        </block>

        <!-- 菜品表单 -->
        <block wx:if="{{editType === 'goods'}}">
          <van-field
            value="{{formData.name}}"
            bind:change="onFieldChange"
            data-field="name"
            label="菜品名称"
            placeholder="请输入菜品名称"
            required
            clearable
            border="{{true}}"
          />

          <!-- 菜品图片：拍照/相册上传到云存储 -->
          <view class="image-upload-section">
            <view class="image-upload-label">菜品图片</view>
            <view class="image-upload-body">
              <view class="image-preview-wrapper" wx:if="{{formData.image}}">
                <image class="image-preview" src="{{formData.image}}" mode="aspectFill" />
                <view class="image-remove" catchtap="removeImage">
                  <van-icon name="cross" size="12px" color="#fff" />
                </view>
              </view>
              <view class="image-upload-btn" bindtap="chooseImage">
                <van-icon name="photograph" size="24px" color="#999" />
                <text>{{formData.image ? '重新上传' : '拍照 / 选图'}}</text>
              </view>
            </view>
            <view class="image-upload-tip">把自己炒的菜拍下来，家人看菜下单更有食欲~</view>
          </view>

          <van-field
            value="{{formData.image}}"
            bind:change="onFieldChange"
            data-field="image"
            label="图片链接"
            placeholder="也可直接粘贴图片 URL（选填）"
            clearable
            border="{{true}}"
          />

          <van-field
            value="{{formData.desc}}"
            bind:change="onFieldChange"
            data-field="desc"
            label="菜品描述"
            type="textarea"
            placeholder="口味特点、家人喜好等"
            maxlength="200"
            show-word-limit
            autosize="{{true}}"
            border="{{true}}"
          />
        </block>
      </scroll-view>

      <!-- 底部按钮 -->
      <view class="modal-footer">
        <van-button 
          block 
          round 
          type="default" 
          bindtap="closeModal"
          custom-class="footer-btn"
        >
          取消
        </van-button>
        <van-button 
          block 
          round 
          type="primary" 
          bindtap="saveForm"
          custom-class="footer-btn"
        >
          保存
        </van-button>
      </view>
    </view>
  </van-popup>
</view>
