.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 顶部操作栏 */
.header {
  background-color: #fff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.actions {
  display: flex;
  gap: 16rpx;
}

/* 按钮样式 */
.btn {
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  background-color: #f0f0f0;
  color: #333;
  border: none;
}

.btn-small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

.btn-primary {
  background-color: #07c160;
  color: #fff;
}

.btn-danger {
  background-color: #ee0a24;
  color: #fff;
}

.btn-icon {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  background-color: #f0f0f0;
  color: #333;
  border: none;
  border-radius: 6rpx;
}

/* 分类标签栏 */
.category-tabs {
  background-color: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #666;
}

.tab-item.active {
  background-color: #07c160;
  color: #fff;
}

.tab-item.add-tab {
  background-color: #e8f5e9;
  color: #07c160;
  font-weight: bold;
}

/* 内容区域 */
.content {
  padding: 20rpx;
}

.category-actions {
  background-color: #fff;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.action-buttons {
  display: flex;
  gap: 12rpx;
}

/* 商品列表 */
.goods-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.goods-item {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  display: flex;
  gap: 20rpx;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background-color: #f5f5f5;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.goods-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.goods-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

.goods-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
}

.goods-price {
  font-size: 32rpx;
  color: #ee0a24;
  font-weight: bold;
}

.goods-original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.goods-sales {
  font-size: 22rpx;
  color: #999;
}

.goods-id {
  font-size: 20rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.goods-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  justify-content: center;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 弹窗样式优化 */
.modal-container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: #fff;
}

.modal-header {
  padding: 32rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #ebedf0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #323233;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 16rpx 0;
}

.modal-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #ebedf0;
  display: flex;
  gap: 16rpx;
  background-color: #fff;
}

.footer-btn {
  flex: 1;
  height: 80rpx !important;
  font-size: 30rpx !important;
}

/* 旧样式保留（兼容性） */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-height: 80vh;
  background-color: #fff;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
}

.modal-footer {
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  gap: 20rpx;
}

.modal-footer .btn {
  flex: 1;
}
