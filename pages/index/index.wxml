<view class="home">

  <!-- 顶部文本介绍 -->
  <view class="intro">
    <view class="intro-title">吃什么 🍜</view>
    <view class="intro-desc">
      好好吃饭，认真运动，把平凡日子过成闪闪发光的小日常 ✨ 随心点一份心仪餐食，打卡记录每一次挥汗成长，闲暇时来局小游戏放松解压。各模块独立运行，启动轻快，随开随用。
    </view>
  </view>

  <!-- 模块卡片 -->
  <view class="module-list">
    <view class="module-card order" bindtap="goOrder">
      <view class="module-icon">🛒</view>
      <view class="module-info">
        <view class="module-name">点单</view>
        <view class="module-sub">浏览菜单 · 下单 · 查看订单</view>
      </view>
      <view class="module-arrow">›</view>
    </view>

    <view class="module-card fitness" bindtap="goFitness">
      <view class="module-icon">🏃</view>
      <view class="module-info">
        <view class="module-name">健身打卡</view>
        <view class="module-sub">一键打卡 · 连续统计 · 勋章激励</view>
      </view>
      <view class="module-arrow">›</view>
    </view>

    <view class="module-card game" bindtap="goGame">
      <view class="module-icon">🎮</view>
      <view class="module-info">
        <view class="module-name">方块跳跳消</view>
        <view class="module-sub">按压蓄力跳跃 · 堆叠消除小游戏</view>
      </view>
      <view class="module-arrow">›</view>
    </view>

    <view class="module-card admin" bindtap="goAdmin" wx:if="{{isAdmin}}">
      <view class="module-icon">⚙️</view>
      <view class="module-info">
        <view class="module-name">后台管理</view>
        <view class="module-sub">菜单维护 · 数据管理</view>
      </view>
      <view class="module-arrow">›</view>
    </view>
  </view>

</view>
