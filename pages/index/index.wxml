<view class="home">

  <!-- 顶部文本介绍 -->
  <view class="intro">
    <view class="intro-title">吃什么 🍜</view>
    <view class="intro-desc">
      今天吃什么？不用再纠结 ✨ 把家里的拿手菜记成专属菜单，分享给家人点菜，吃完还能点评送爱心；饭后打卡运动、闲时来局小游戏，把平凡日子过成闪闪发光的小日常。
    </view>
  </view>

  <!-- 模块卡片 -->
  <view class="module-list">
    <view class="module-card order" bindtap="goOrder">
      <view class="module-icon">🛒</view>
      <view class="module-info">
        <view class="module-name">点单</view>
        <view class="module-sub">浏览菜单 · 下单 · 查看订单</view>
      </view>
      <view class="module-arrow">›</view>
    </view>

    <view class="module-card fitness" bindtap="goFitness">
      <view class="module-icon">🏃</view>
      <view class="module-info">
        <view class="module-name">健身打卡</view>
        <view class="module-sub">一键打卡 · 连续统计 · 勋章激励</view>
      </view>
      <view class="module-arrow">›</view>
    </view>

    <!-- 小游戏合集：点击弹窗选择具体游戏 -->
    <view class="module-card game" bindtap="openGamePicker">
      <view class="module-icon">🎮</view>
      <view class="module-info">
        <view class="module-name">小游戏</view>
        <view class="module-sub">方块跳跳消 · 一杆进洞 · 乾坤挪移</view>
      </view>
      <view class="module-arrow">›</view>
    </view>

    <view class="module-card admin" bindtap="goAdmin">
      <view class="module-icon">📖</view>
      <view class="module-info">
        <view class="module-name">我的菜单</view>
        <view class="module-sub">记录拿手菜 · 自拍菜品图 · 专属家庭菜单</view>
      </view>
      <view class="module-arrow">›</view>
    </view>
  </view>

  <!-- 游戏选择弹窗 -->
  <view class="game-mask" wx:if="{{gamePickerShow}}" bindtap="closeGamePicker" catchtouchmove="noop">
    <view class="game-sheet" catchtap="noop">
      <view class="game-sheet-head">
        <text class="game-sheet-title">🎮 选个游戏玩会儿</text>
        <text class="game-sheet-close" catchtap="closeGamePicker">✕</text>
      </view>
      <view class="game-list">
        <view
          wx:for="{{games}}"
          wx:key="url"
          class="game-item"
          data-url="{{item.url}}"
          bindtap="goPlay"
        >
          <view class="game-item-icon" style="background: {{item.bg}};">{{item.icon}}</view>
          <view class="game-item-info">
            <view class="game-item-name">{{item.name}}</view>
            <view class="game-item-sub">{{item.sub}}</view>
          </view>
          <view class="module-arrow">›</view>
        </view>
      </view>
    </view>
  </view>

</view>
