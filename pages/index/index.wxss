.home {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #f0fbf4 0%, #f7f8fa 40%);
}

/* 顶部介绍 */
.intro {
  padding: 24rpx 8rpx 40rpx;
}

.intro-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.3;
}

.intro-desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #7a7a7a;
  line-height: 1.7;
}

/* 模块卡片 */
.module-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.module-card {
  display: flex;
  align-items: center;
  padding: 40rpx 36rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.module-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.module-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}

.module-card.order .module-icon {
  background: #e6f9ee;
}

.module-card.admin .module-icon {
  background: #eaf1ff;
}

.module-card.fitness .module-icon {
  background: #fff2ec;
}

.module-card.game .module-icon {
  background: #f3ecff;
}

.module-info {
  flex: 1;
  margin-left: 28rpx;
}

.module-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.module-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

.module-arrow {
  font-size: 48rpx;
  color: #c8c8c8;
  flex-shrink: 0;
}
